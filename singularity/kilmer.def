Bootstrap: docker
From: rockylinux:8

%post
    dnf install -y epel-release
    dnf config-manager --set-enabled powertools
    dnf install -y \
        vim \
        which \
        python3.11 \
        Lmod \
        procps-ng \
        tcsh \
        libXt \
        libXft \
        libXp \
        libXpm \
        libpng12 \
        git \
        bc \
        rsync \
        libtiff \
        libwebp \
        pango \
        librsvg2 \
        libtool-ltdl \
        libgomp \
        urw-base35-fonts \
        jq \
        libquadmath \
        poppler-utils

%environment
    export AFNI_NIFTI_NOEXT=YES

%runscript
    source .venv/bin/activate
    source ./modules_rocky8.sh
    .venv/bin/python3 $@

%apprun tedana
    source .tedana/bin/activate
    source ./modules_rocky8.sh
    .tedana/bin/python3 $@
